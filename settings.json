{
  // -------------------------------------------------------------------
  // Workbench & Window Appearance
  // -------------------------------------------------------------------
  "workbench.activityBar.location": "top",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.settings.applyToAllProfiles": ["files.trimTrailingWhitespace"],
  "workbench.startupEditor": "none",
  "window.menuBarVisibility": "compact",
  "window.titleBarStyle": "custom",
  "zenMode.showTabs": "none",
  "update.mode": "default",
  "telemetry.telemetryLevel": "off",

  // -------------------------------------------------------------------
  // Editor Core & Behavior
  // -------------------------------------------------------------------
  "editor.accessibilitySupport": "off",
  "editor.autoClosingBrackets": "never",
  "editor.autoClosingQuotes": "never",
  "editor.autoSurround": "never",
  "editor.bracketPairColorization.enabled": true,
  "editor.copyWithSyntaxHighlighting": false,
  "editor.cursorSurroundingLines": 10,
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', Consolas, monospace",
  "editor.fontLigatures": false,
  "editor.fontSize": 14,
  "editor.fontVariations": true,
  "editor.largeFileOptimizations": false,
  "editor.lineNumbers": "relative",
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "none",
  "editor.semanticHighlighting.enabled": true,
  "editor.tabSize": 2,
  "editor.unicodeHighlight.ambiguousCharacters": true,
  "editor.useTabStops": false,

  // -------------------------------------------------------------------
  // Files, Explorer & Search
  // -------------------------------------------------------------------
  "files.associations": {
    "*.log": "log",
    "*.inc": "cpp",
    "*.h": "cpp",
    "*.in": "cpp",
    "cctype": "cpp",
    "clocale": "cpp",
    "cmath": "cpp",
    "csetjmp": "cpp",
    "csignal": "cpp",
    "cstdarg": "cpp",
    "cstddef": "cpp",
    "cstdio": "cpp",
    "cstdlib": "cpp",
    "cstring": "cpp",
    "ctime": "cpp",
    "cwchar": "cpp",
    "cwctype": "cpp",
    "any": "cpp",
    "array": "cpp",
    "atomic": "cpp",
    "strstream": "cpp",
    "bit": "cpp",
    "*.tcc": "cpp",
    "bitset": "cpp",
    "cfenv": "cpp",
    "charconv": "cpp",
    "chrono": "cpp",
    "cinttypes": "cpp",
    "codecvt": "cpp",
    "complex": "cpp",
    "condition_variable": "cpp",
    "cstdint": "cpp",
    "cuchar": "cpp",
    "deque": "cpp",
    "forward_list": "cpp",
    "list": "cpp",
    "map": "cpp",
    "set": "cpp",
    "unordered_map": "cpp",
    "unordered_set": "cpp",
    "vector": "cpp",
    "exception": "cpp",
    "algorithm": "cpp",
    "functional": "cpp",
    "iterator": "cpp",
    "memory": "cpp",
    "memory_resource": "cpp",
    "numeric": "cpp",
    "optional": "cpp",
    "random": "cpp",
    "ratio": "cpp",
    "regex": "cpp",
    "string": "cpp",
    "string_view": "cpp",
    "system_error": "cpp",
    "tuple": "cpp",
    "type_traits": "cpp",
    "utility": "cpp",
    "fstream": "cpp",
    "future": "cpp",
    "initializer_list": "cpp",
    "iomanip": "cpp",
    "iosfwd": "cpp",
    "iostream": "cpp",
    "istream": "cpp",
    "limits": "cpp",
    "mutex": "cpp",
    "new": "cpp",
    "ostream": "cpp",
    "scoped_allocator": "cpp",
    "shared_mutex": "cpp",
    "sstream": "cpp",
    "stdexcept": "cpp",
    "streambuf": "cpp",
    "thread": "cpp",
    "typeindex": "cpp",
    "typeinfo": "cpp",
    "valarray": "cpp",
    "variant": "cpp",
    "*.rcp": "cdl",
    "*impl.h": "cpp",
  },
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/__history": true,
    "**/__recovery": true,
    "**/node_modules/*/**": false,
    "install/**": true,
  },
  "explorer.autoRevealExclude": {
    "**/node_modules": false,
    "install/**": true,
  },
  "explorer.confirmDelete": false,
  "search.exclude": {
    "**/node_modules": false,
    "**/__history": true,
    "**/__recovery": true,
  },
  "security.workspace.trust.untrustedFiles": "open",

  // -------------------------------------------------------------------
  // Terminal Integrated
  // -------------------------------------------------------------------
  "terminal.integrated.altClickMovesCursor": false,
  "terminal.integrated.autoReplies": {
    "Terminate batch job (Y/N)": "Y\r",
  },
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.defaultLocation": "view",
  "terminal.integrated.defaultProfile.linux": "zsh",
  "terminal.integrated.defaultProfile.osx": "",
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono'",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.initialHint": false,
  "terminal.integrated.letterSpacing": 0.8,
  "terminal.integrated.lineHeight": 1.1,
  "terminal.integrated.minimumContrastRatio": 1,
  "terminal.integrated.profiles.windows": {
    "PowerShell": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
    },
    "Command Prompt": {
      "path": [
        "${env:windir}\\Sysnative\\cmd.exe",
        "${env:windir}\\System32\\cmd.exe",
      ],
      "args": [],
      "icon": "terminal-cmd",
    },
    "Git Bash": {
      "source": "Git Bash",
    },
  },
  "terminal.integrated.scrollback": 10000,

  // -------------------------------------------------------------------
  // Git & SCM
  // -------------------------------------------------------------------
  "git.blame.editorDecoration.enabled": true,
  "git.blame.statusBarItem.enabled": false,
  "git.openRepositoryInParentFolders": "never",
  "git.suggestSmartCommit": false,
  "scm.repositories.selectionMode": "single",

  // -------------------------------------------------------------------
  // Language & Extension Specifics
  // -------------------------------------------------------------------
  "C_Cpp.codeFolding": "disabled",
  "C_Cpp.default.intelliSenseMode": "msvc-x86",
  "C_Cpp.workspaceParsingPriority": "high",
  "cmake.configureOnEdit": false,
  "cmake.pinnedCommands": [
    "workbench.action.tasks.configureTaskRunner",
    "workbench.action.tasks.runTask",
  ],
  "cmake.showOptionsMovedNotification": false,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "cpp": true,
    "vue": true,
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "github.copilot.nextEditSuggestions.fixes": false,
  "doxdocgen.cpp.ctorText": "Constructor",
  "doxdocgen.cpp.dtorText": "Destructor",
  "doxdocgen.generic.returnTemplate": "@returns",
  "protobuf.autoDetection.enabled": false,
  "protobuf.autoDetection.prompted": true,
  "protobuf.maxLineLength": 90,
  "protobuf.renumber.onFormat": true,
  "remote.SSH.remotePlatform": {
    "mlr-lb-161": "linux",
    "mlr-lb-161.dom-mlr": "linux",
    "ws": "linux",
  },
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "extensions.ignoreRecommendations": true,
  "grunt.autoDetect": "on",
  "rewrap.wrappingColumn": 90,
  "diffEditor.ignoreTrimWhitespace": false,
  "chat.viewSessions.orientation": "stacked",

  // -------------------------------------------------------------------
  // Language Specific Overrides
  // -------------------------------------------------------------------
  "[cpp]": {
    "editor.wordBasedSuggestions": "allDocuments",
    "editor.suggest.insertMode": "insert",
    "editor.semanticHighlighting.enabled": true,
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "[log]": {
    "editor.largeFileOptimizations": false,
  },
  // "catppuccin.accentColor": "mauve",
  // "catppuccin.bracketMode": "neovim",
  // "catppuccin.italicKeywords": false,
  // "catppuccin.italicComments": false,
  // "catppuccin.boldKeywords": true,
  // "catppuccin.colorOverrides": {
  //   "macchiato": {
  //     "base": "#24273a",
  //     "mantle": "#24273a",
  //     "crust": "#24273a"
  //   }
  // },
  "logFileHighlighter.customPatterns": [
    {
      "pattern": "\\d{4}\\.\\d{2}\\.\\d{2}\\s+\\d{2}:\\d{2}:\\d{2}-\\d{3}",
      "foreground": "#959cbd",
    },
    {
      "pattern": "\\btrace\\b",
      "patternFlags": "i",
      "foreground": "#8dbaf8",
    },
    {
      "pattern": "\\bdebug\\b",
      "patternFlags": "i",
      "foreground": "#6aa9ff",
    },
    {
      "pattern": "\\binfo\\b",
      "patternFlags": "i",
      "foreground": "#00c853",
    },
    {
      "pattern": "\\bwarn(ing)?\\b",
      "patternFlags": "i",
      "foreground": "#ffb300",
    },
    {
      "pattern": "\\berror\\b",
      "patternFlags": "i",
      "foreground": "#ff5252",
      "fontWeight": "bold",
    },
    {
      "pattern": "\\bfatal\\b",
      "patternFlags": "i",
      "foreground": "#ff1744",
      "fontWeight": "bold",
    },
    {
      "pattern": "\\bcritical\\b",
      "patternFlags": "i",
      "foreground": "#ff1744",
      "fontWeight": "bold",
    },
  ],
  "workbench.colorCustomizations": {
    // "[Catppuccin Mocha]": {
    //   "editor.findMatchBorder": "#89b4fa",
    //   "editor.findMatchBackground": "#89b4fa",
    //   "editor.findMatchForeground": "#ffffff",
    //   "editor.findMatchHighlightBackground": "#8c4ea880",
    //   "editor.findMatchHighlightForeground": "#ffffff80",
    //   "editorIndentGuide.background1": "#45475a",
    //   "editorIndentGuide.activeBackground1": "#45475a"
    // },
    "[Tokyo Night Storm]": {
      "foreground": "#959cbd",
      "editorLineNumber.foreground": "#9aa5ce",
      "editorLineNumber.activeForeground": "#ff9e64",
      "panelTitle.activeBorder": "#3d59a1",
      "panelTitle.activeForeground": "#bdc7f0",
      "panelTitle.inactiveForeground": "#959cbd",
      "tab.inactiveForeground": "#959cbd",
      "breadcrumb.foreground": "#959cbd",
      "breadcrumb.focusForeground": "#bdc7f0",
      "breadcrumb.activeSelectionForeground": "#bdc7f0",
      "statusBar.foreground": "#bdc7f0",
      "list.focusForeground": "#bdc7f0",
      "list.hoverForeground": "#bdc7f0",
      "sideBar.foreground": "#959cbd",
      "dropdown.foreground": "#959cbd",
      "menu.foreground": "#bdc7f0",
      "menubar.selectionForeground": "#bdc7f0",
      "input.foreground": "#959cbd",
      "input.placeholderForeground": "#959cbd",
      "activityBar.foreground": "#bdc7f0",
      "activityBar.inactiveForeground": "#787c99",
      "gitDecoration.ignoredResourceForeground": "#696d87",
      "editor.findMatchBackground": "#ff9e6433",
      "editor.findMatchBorder": "#ff9e64",
      "editor.findMatchHighlightBackground": "#7dcfff40",
      "tab.activeBackground": "#292e42",
      "tab.unfocusedActiveBackground": "#292e42",
      "tab.activeBorderTop": "#ff9e64",
      "tab.activeForeground": "#c0caf5",
      "list.activeSelectionBackground": "#3b4261",
      "list.activeSelectionForeground": "#c0caf5",
      "list.inactiveSelectionBackground": "#5a341f",
      "list.inactiveSelectionForeground": "#c0caf5",
    },
    "[Rosé Pine Moon (no italics)]": {
      "editorLineNumber.activeForeground": "#F6C177",
      "editorLineNumber.foreground": "#6E6A86",
    },
  },
  "editor.tokenColorCustomizations": {
    "[GitHub Dark Dimmed]": {
      "textMateRules": [
        {
          "scope": ["keyword.control", "keyword.other", "source.cmake keyword"],
          "settings": {
            "foreground": "#bb9af7",
          },
        },
        {
          "scope": [
            "storage.type",
            "storage.modifier",
            "entity.name.tag",
            "variable.language.this",
            "variable.parameter.function.language.special.self.python",
            "variable.language.special.self.python",
          ],
          "settings": {
            "foreground": "#7aa2f7",
          },
        },
        {
          "scope": ["punctuation.definition.tag", "keyword.operator"],
          "settings": {
            "foreground": "#89ddff",
          },
        },
      ],
    },
    "[Tokyo Night Storm]": {
      "textMateRules": [
        {
          "scope": [
            "comment",
            "meta.var.expr storage.type",
            "keyword.control.flow",
            "keyword.control.return",
            "meta.directive.vue punctuation.separator.key-value.html",
            "meta.directive.vue entity.other.attribute-name.html",
            "tag.decorator.js entity.name.tag.js",
            "tag.decorator.js punctuation.definition.tag.js",
            "storage.modifier",
          ],
          "settings": {
            "fontStyle": "",
          },
        },
        {
          "scope": [
            "comment keyword.codetag.notation",
            "comment.block.documentation keyword",
            "comment.block.documentation storage.type.class",
          ],
          "settings": {
            "foreground": "#bb9af7",
          },
        },
        {
          "scope": ["comment", "punctuation.definition.comment"],
          "settings": {
            "foreground": "#9aa5ce",
            "fontStyle": "",
          },
        },
        {
          "scope": ["comment.block.documentation entity.name.type.instance"],
          "settings": {
            "foreground": "#73daca",
            "fontStyle": "italic",
          },
        },
        {
          "scope": [
            "comment.block.documentation entity.name.type punctuation.definition.bracket",
          ],
          "settings": {
            "foreground": "#bb9af7",
          },
        },
        {
          "scope": ["comment.block.documentation variable"],
          "settings": {
            "foreground": "#e0af68",
            "fontStyle": "italic",
          },
        },
        {
          "scope": [
            "variable.other.unknown.cpp",
            "variable.other.unknown",
            "variable.other",
            "variable.snake-case.cpp",
          ],
          "settings": {
            "foreground": "#c0caf5",
          },
        },
      ],
    },
    "[Rosé Pine Moon (no italics)]": {
      "textMateRules": [
        {
          "name": "Comments - higher contrast",
          "scope": [
            "comment",
            "comment.line",
            "comment.block",
            "comment.line.double-slash",
            "comment.block.documentation",
            "punctuation.definition.comment",
          ],
          "settings": {
            "foreground": "#A6ADC8",
          },
        },
      ],
    },
  },
  "terminal.integrated.profiles.linux": {
    "bash": {
      "path": "bash",
      "icon": "terminal-bash",
    },
    "zsh": {
      "path": "/usr/bin/zsh",
    },
    "fish": {
      "path": "fish",
    },
    "tmux": {
      "path": "tmux",
      "icon": "terminal-tmux",
    },
    "pwsh": {
      "path": "pwsh",
      "icon": "terminal-powershell",
    },
  },
  "workbench.colorTheme": "Tokyo Night Storm",
  "git.addAICoAuthor": "off",
}
